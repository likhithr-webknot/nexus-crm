# Backend configuration. Copy to .env (ignored by git) and fill in.
# Spring Boot does not read .env files by itself; load it into the shell first:
#   set -a; source .env; set +a; ./mvnw spring-boot:run

# --- Database ---------------------------------------------------------------
NEXUS_DB_URL=jdbc:postgresql://localhost:5432/nexus_crm
NEXUS_DB_USERNAME=nexus_crm
NEXUS_DB_PASSWORD=

# --- Google sign-in ---------------------------------------------------------
# An OAuth 2.0 "Web application" client from Google Cloud Console.
# Authorised redirect URI: http://localhost:8080/api/v1/auth/login/oauth2/code/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Access-token signing key (ES256) ---------------------------------------
# Local development: let the app generate a throwaway key at each start.
NEXUS_JWT_ALLOW_EPHEMERAL_KEY=true
# Everywhere else: a real key pair (see README, "Signing key") and no ephemeral key.
# NEXUS_JWT_PRIVATE_KEY=
# NEXUS_JWT_PUBLIC_KEY=

# --- Application ------------------------------------------------------------
# The frontend's origin.
NEXUS_FRONTEND_URL=http://localhost:3000
# Invited as the first admin while the user table is empty. Use your own Google address.
NEXUS_BOOTSTRAP_ADMIN_EMAIL=
# Set to "framework" only behind a reverse proxy that sets X-Forwarded-* headers.
# NEXUS_FORWARD_HEADERS=framework
# Browsers accept Secure cookies on http://localhost, except Safari. Set to false for Safari locally.
# NEXUS_COOKIES_SECURE=false
