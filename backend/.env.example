# Backend configuration. Copy to .env (ignored by git) and fill in.
# Spring Boot does not read .env files by itself; load it into the shell first:
#   set -a; source .env; set +a; ./mvnw spring-boot:run

# --- Database ---------------------------------------------------------------
NEXUS_DB_URL=jdbc:postgresql://localhost:5432/nexus_crm
NEXUS_DB_USERNAME=nexus_crm
NEXUS_DB_PASSWORD=

# --- Google sign-in ---------------------------------------------------------
# An OAuth 2.0 "Web application" client from Google Cloud Console.
# Authorised redirect URI: http://localhost:8080/api/v1/auth/login/oauth2/code/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Access-token signing key (ES256) ---------------------------------------
# Local development: let the app generate a throwaway key at each start.
NEXUS_JWT_ALLOW_EPHEMERAL_KEY=true
# Everywhere else: a real key pair (see README, "Signing key") and no ephemeral key.
# NEXUS_JWT_PRIVATE_KEY=
# NEXUS_JWT_PUBLIC_KEY=

# --- Application ------------------------------------------------------------
# Set to "production" on the real server. The app then refuses to start with an empty database password,
# a throwaway signing key, insecure cookies or a frontend address that is not https.
# NEXUS_ENVIRONMENT=production
# The frontend's origin.
NEXUS_FRONTEND_URL=http://localhost:3000
# Invited as the first admin while the user table is empty. Use your own Google address.
NEXUS_BOOTSTRAP_ADMIN_EMAIL=
# Set to "framework" only behind a reverse proxy that sets X-Forwarded-* headers.
# NEXUS_FORWARD_HEADERS=framework
# Browsers accept Secure cookies on http://localhost, except Safari. Set to false for Safari locally.
# NEXUS_COOKIES_SECURE=false

# --- Exchange rates ---------------------------------------------------------
# The server downloads daily rates. Set to false to switch the download off (the rates already saved stay in use).
# NEXUS_FX_ENABLED=true

# --- Google Workspace mail --------------------------------------------------
# Enable the Gmail API on the same Google Cloud project and add this second
# authorised redirect URI to the OAuth client.
NEXUS_MAIL_REDIRECT_URI=http://localhost:8080/api/v1/mail/callback
# Base64 of 32 random bytes. Keep stable; changing it disconnects saved mailboxes.
# To replace the key without disconnecting anyone, list the new key first and the old one after it, separated by a comma.
NEXUS_MAIL_TOKEN_KEY=

# --- OpenAI assistant -------------------------------------------------------
# Keep this server-side. Do not use a NEXT_PUBLIC_ variable or commit a key.
OPENAI_API_KEY=
NEXUS_AI_KEY_NAME=primary
NEXUS_AI_MODEL=gpt-6-luna
# Required to save an API key in Settings: a 32-byte base64 key. It must be a different key from NEXUS_MAIL_TOKEN_KEY.
# Same rule for replacing it: new key first, old key after it, separated by a comma.
# (Keys saved by an older version with the mail key are still read, and move to this key when saved again.)
NEXUS_AI_CONFIG_KEY=
# Optional internal request allowance. An alert is sent at 80%.
# NEXUS_AI_MONTHLY_REQUEST_LIMIT=10000
